# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID from the same app's General Information page
DISCORD_CLIENT_ID=
# Optional: register /claude in one server only (instant instead of ~1h global rollout)
DISCORD_GUILD_ID=

# --- Claude ----------------------------------------------------------------
# Long-lived OAuth token tied to your Claude Pro/Max subscription.
# Generate on your machine with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative to the above: pay-per-token API billing instead of your subscription.
# ANTHROPIC_API_KEY=

# --- Optional tuning -------------------------------------------------------
# CLAUDE_MODEL=claude-sonnet-5   set to claude-opus-5 for harder questions
# CLAUDE_TIMEOUT_MS=120000
# CLAUDE_MAX_CONCURRENT=3
# Tool round-trips allowed per question (history lookups need a few).
# CLAUDE_MAX_TURNS=6

# Recent messages handed to Claude with every question, so simple follow-ups
# need no tool call. 0 disables the prefetch and leaves it to fetch_history.
# RECENT_MESSAGES=5

# Web search and page fetch are on. Set to off to take the bot off the internet.
# WEB_TOOLS=off

# --- Discord tool limits ----------------------------------------------------
# HISTORY_DEFAULT_LIMIT=50        messages returned when Claude gives no limit
# HISTORY_MAX_LIMIT=200           hard cap per call, whatever Claude asks for
# HISTORY_MAX_CHARS=6000          transcript budget; oldest lines dropped first
# ATTACHMENT_MAX_TEXT_BYTES=262144    largest text file read_attachment downloads
# ATTACHMENT_MAX_IMAGE_BYTES=4194304  largest image it downloads
# ATTACHMENT_MAX_CHARS=8000       text kept from a file (the tail, for logs)
