# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID from the same app's General Information page
DISCORD_CLIENT_ID=
# Optional: register /claude in one server only (instant instead of ~1h global rollout)
DISCORD_GUILD_ID=

# --- Claude ----------------------------------------------------------------
# Long-lived OAuth token tied to your Claude Pro/Max subscription.
# Generate on your machine with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative to the above: pay-per-token API billing instead of your subscription.
# ANTHROPIC_API_KEY=

# --- Optional tuning -------------------------------------------------------
# CLAUDE_MODEL=claude-sonnet-5   set to claude-opus-5 for harder questions
# CLAUDE_TIMEOUT_MS=120000
# CLAUDE_MAX_CONCURRENT=3
# Tool round-trips allowed per question (history lookups need a few).
# CLAUDE_MAX_TURNS=6

# Recent messages handed to Claude with every question, so simple follow-ups
# need no tool call. 0 disables the prefetch and leaves it to fetch_history.
# RECENT_MESSAGES=5

# Web search and page fetch are on. Set to off to take the bot off the internet.
# WEB_TOOLS=off

# --- Rate limits ------------------------------------------------------------
# Every accepted question spends subscription quota, so these are what stops a
# channel from spending it all. All three apply at once; over any of them the
# question is refused, not queued. Set a limit to off to disable it.
# Per user this is a token bucket: BURST is how many are available at once,
# PER_HOUR how fast they come back. A bucket admits burst+rate in one hour, so
# keep BURST below PER_HOUR (it is capped to it anyway).
# RATE_LIMIT_USER_BURST=5         questions available back-to-back
# RATE_LIMIT_USER_PER_HOUR=10     tokens refilled per hour, one every 6 min
# RATE_LIMIT_GLOBAL_PER_HOUR=40   burst ceiling across everyone
# RATE_LIMIT_GLOBAL_PER_DAY=200   backstop a slow drip cannot walk past
# Comma-separated Discord user IDs that skip every limit, for the bot's owner.
# RATE_LIMIT_EXEMPT_IDS=

# Questions allowed to wait for a free slot before the bot says it is busy.
# A queued question is not covered by CLAUDE_TIMEOUT_MS, which only starts once
# the query does.
# CLAUDE_MAX_QUEUE=8

# Channels the bot may operate in, comma separated. Empty means every server
# channel it can see. Direct messages are off regardless of this setting.
# ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789

# --- Telemetry --------------------------------------------------------------
# Unset, the OpenTelemetry SDK never starts and the instrument calls are no-ops.
# Set it to an OTLP/HTTP collector and the bot exports metrics, traces and one
# structured event per question.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc:4318
# OTEL_SERVICE_NAME=claude-bot
# OTEL_METRIC_EXPORT_INTERVAL=15000

# --- Discord tool limits ----------------------------------------------------
# HISTORY_DEFAULT_LIMIT=50        messages returned when Claude gives no limit
# HISTORY_MAX_LIMIT=200           hard cap per call, whatever Claude asks for
# HISTORY_MAX_CHARS=6000          transcript budget; oldest lines dropped first
# ATTACHMENT_MAX_TEXT_BYTES=262144    largest text file read_attachment downloads
# ATTACHMENT_MAX_IMAGE_BYTES=4194304  largest image it downloads
# ATTACHMENT_MAX_CHARS=8000       text kept from a file (the tail, for logs)
